# ---------- Phase 01: server ----------
PORT=4000
NODE_ENV=development
# Production note: Set NODE_VERSION=22 in Render service environment.
# Comma-separated. 3000 = Next.js (Phase 31), 5173 = widget dev server (Phase 33).
# Production: set to frontend domain, e.g. https://<your-site>.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ---------- Phase 02: logging ----------
# debug | info | warn | error
# Production: info
LOG_LEVEL=info

# ---------- Phase 03: database ----------
# Local: postgresql://counseldesk:counseldesk@localhost:5433/counseldesk
# Production: Use Neon direct connection string (never pooled/PgBouncer for migrations), ending in ?sslmode=require
# e.g. postgresql://counseldesk_owner:secret@ep-xyz-pooler.us-east-2.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://counseldesk:counseldesk@localhost:5433/counseldesk

# ---------- Phase 06: staff auth ----------
# Two different values, 32+ characters each: openssl rand -hex 32
# Production: Generate fresh random keys; NEVER reuse development or CI secrets!
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------- Phase 08: Redis + rate limiting ----------
# Local: localhost:6381
# Production: Hosted Redis (e.g. Redis Cloud free tier) with eviction policy set to `noeviction` (required for BullMQ).
REDIS_HOST=localhost
REDIS_PORT=6381
# Empty locally; set both for hosted Redis with auth.
REDIS_USERNAME=
REDIS_PASSWORD=
# Proxies whose client-IP headers may be trusted.
# Production on Render: 127.0.0.1/32
TRUSTED_PROXY_CIDRS=

# ---------- Phase 09: email (Gmail API) ----------
# Lead notifications and password-reset links are sent through the Gmail API from one dedicated
# mailbox. One-time setup (docs/gmail-api-email-sender.md): fill the first four lines, start the API,
# open http://localhost:4000/auth/gmail as the sender account, then paste the refresh token printed in
# the server console into GMAIL_REFRESH_TOKEN and restart. Without credentials, non-production runs
# print each message to the log instead of sending it; production refuses to send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/auth/gmail/callback
GMAIL_SENDER_ADDRESS=
GMAIL_REFRESH_TOKEN=
# Optional display name shown next to the sender address.
GMAIL_SENDER_NAME=
# The authorization routes are always on outside production; "true" only while re-authorizing there
# (a Google app in "Testing" status loses its refresh token after 7 days).
GMAIL_OAUTH_SETUP=false
# Who gets the new-lead email.
STAFF_NOTIFY_EMAIL=
# Where staff open a conversation (Phase 36). Production: https://<your-site>.vercel.app
STAFF_APP_URL=http://localhost:3000
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

# ---------- Phase 11: embeddings ----------
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ---------- Phase 14: chat models ----------
NVIDIA_CHAT_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Fallback provider. GEMINI_API_KEY is shared with the embedding client.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash

# ---------- Phase 15: citations ----------
# Where the demo firm site runs; citation links point here.
# Production: https://<your-site>.vercel.app
SITE_URL=http://localhost:3000
ANSWER_PROMPT_VERSION=answer.v1

# ---------- Phase 23: experiments ----------
# or | and (websearch_to_tsquery)
KEYWORD_QUERY=or
# low | medium | high
GEMINI_THINKING_LEVEL=low
# gemini | nvidia
LLM_PRIMARY=nvidia
