    "execute": [
      {
        "description": "create table \"Appointment\"",
        "sql": "CREATE TABLE \"public\".\"Appointment\" (\n  \"attorneyId\" uuid NOT NULL,\n  \"cancelledAt\" timestamptz,\n  \"caseType\" text NOT NULL,\n  \"confirmedAt\" timestamptz,\n  \"conversationId\" uuid,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"email\" text,\n  \"endsAt\" timestamptz NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"leadId\" uuid,\n  \"linkVersion\" int4 DEFAULT 1 NOT NULL,\n  \"mode\" text DEFAULT 'video' NOT NULL,\n  \"name\" text NOT NULL,\n  \"phone\" text,\n  \"slotKey\" text,\n  \"startsAt\" timestamptz NOT NULL,\n  \"status\" text DEFAULT 'booked' NOT NULL,\n  \"summary\" text,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Appointment_caseType_check_a2235d1b\" CHECK (\"caseType\" IN ('dui', 'criminal_defense', 'family_law', 'personal_injury', 'estate_planning', 'other')),\n  CONSTRAINT \"Appointment_mode_check_7b158617\" CHECK (\"mode\" IN ('video', 'in_person')),\n  CONSTRAINT \"Appointment_status_check_e31768d9\" CHECK (\"status\" IN ('booked', 'cancelled', 'completed', 'no_show'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Appointment\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Appointment\""
        ]
      }
    ]
  },
