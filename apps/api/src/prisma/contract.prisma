// use prisma-8

enum ConversationStatus {
    @@type("pg/text@1")

    open
    needs_human
    closed
}

enum MessageRole {
    @@type("pg/text@1")

    user
    assistant
}

// The practice areas the demo firm handles, plus `other`. The lead tool may only pick one of these.
enum CaseType {
    @@type("pg/text@1")

    dui
    criminal_defense
    family_law
    personal_injury
    estate_planning
    other
}

enum HandoffStatus {
    @@type("pg/text@1")

    pending
    resolved
}

enum LlmPurpose {
    @@type("pg/text@1")

    route
    answer
    lead
    embed_query
    embed_document
}

// One page of the demo firm's website. `path` is the URL path on the site ("/practice-areas/dui"),
// which is also what a citation links to.
model Page {
    id          Uuid              @id @default(uuid())
    path        String            @unique
    title       String
    // sha256 of everything that decides this page's stored sections (its markdown, the split depth
    // and the embedding model — Phase 11), so re-running ingestion can skip unchanged pages.
    contentHash String
    createdAt   TimestamptzString @default(now())
    updatedAt   TimestamptzString @default(now())
    sections    Section[]
}

// One heading-sized part of a page: what search returns and what an answer cites.
model Section {
    id             Uuid                          @id @default(uuid())
    pageId         Uuid
    // URL fragment for this heading ("fees-and-payment-plans"); citation = page path + "#" + anchor.
    anchor         String
    heading        String
    content        String
    // heading + "\n" + content: the one column keyword search indexes.
    searchText     String
    // Order of the section within its page, for rebuilding the page and for stable test output.
    position       Int
    contentHash    String
    embedding      pgvector.Vector(length: 2048)
    // Which model produced `embedding`. Vectors from different models must never be compared.
    embeddingModel String
    createdAt      TimestamptzString             @default(now())
    page           Page                          @relation(fields: [pageId], references: [id], onDelete: Cascade)
    citations      MessageCitation[]

    @@unique([pageId, anchor])
    @@index([pageId])
    @@fullTextIndex([searchText], name: "section_search_text")
}

model Conversation {
    id        Uuid               @id @default(uuid())
    // The anonymous visitor cookie (Phase 08), so one browser's chats can be grouped and rate limited.
    visitorId String
    status    ConversationStatus @default(open)
    createdAt TimestamptzString  @default(now())
    updatedAt TimestamptzString  @default(now())
    messages  Message[]
    lead      Lead?
    handoff   Handoff?
    llmCalls  LlmCall[]

    @@index([visitorId])
    // The staff queue: "conversations needing a human, newest activity first".
    @@index([status, updatedAt])
}

model Message {
    id             Uuid              @id @default(uuid())
    conversationId Uuid
    role           MessageRole
    content        String
    // Set on assistant messages: what the router decided and which prompt produced the answer.
    intent         String?
    promptVersion  String?
    // The request that produced this message: joins it to its llmCall rows (a trace).
    requestId      String?
    routeMs        Int?
    // Stage timings for assistant messages (Phase 20), in milliseconds.
    retrieveMs     Int?
    firstTokenMs   Int?
    totalMs        Int?
    createdAt      TimestamptzString @default(now())
    conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    citations      MessageCitation[]

    @@index([conversationId, createdAt])
    @@index([requestId])
}

model MessageCitation {
    id        Uuid     @id @default(uuid())
    messageId Uuid
    // Null once the section is deleted by re-ingestion; the snapshot below keeps the meaning.
    sectionId Uuid?
    // The [n] shown in the answer.
    number    Int
    url       String
    heading   String
    message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
    section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

    @@unique([messageId, number])
    @@index([sectionId])
}

model Lead {
    id             Uuid              @id @default(uuid())
    // Unique: one lead per conversation, however many times the model calls the tool.
    conversationId Uuid              @unique
    name           String
    email          String?
    phone          String?
    caseType       CaseType
    // One or two sentences from the visitor about their situation, if they gave any.
    summary        String?
    createdAt      TimestamptzString @default(now())
    // Set by the notify worker after the staff email is sent; a retried job checks it first.
    notifiedAt     TimestamptzString?
    conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([createdAt])
    @@check(expression: "email IS NOT NULL OR phone IS NOT NULL", name: "lead_has_contact")
}

model Handoff {
    id             Uuid              @id @default(uuid())
    conversationId Uuid              @unique
    reason         String
    status         HandoffStatus     @default(pending)
    createdAt      TimestamptzString @default(now())
    // Null until staff resolve it.
    resolvedAt     TimestamptzString?
    // Who resolved it. SetNull: removing a staff account keeps the history.
    resolvedById   Uuid?
    resolvedBy     User?             @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
    conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([status, createdAt])
}

model LlmCall {
    id             Uuid              @id @default(uuid())
    // The X-Request-Id of the request that made the call (Phase 02); null for scripts and evals.
    requestId      String?
    conversationId Uuid?
    purpose        LlmPurpose
    provider       String
    model          String
    promptVersion  String?
    inputTokens    Int               @default(0)
    outputTokens   Int               @default(0)
    latencyMs      Int
    // Streaming calls only: time until the first token arrived.
    firstTokenMs   Int?
    // Estimated cost in millionths of a US dollar (Phase 20 explains the estimate).
    costMicros     Int               @default(0)
    // True when the primary provider failed and this row is the fallback's answer.
    fellBack       Boolean           @default(false)
    ok             Boolean
    errorCode      String?
    createdAt      TimestamptzString @default(now())
    conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

    @@index([createdAt])
    @@index([conversationId])
    @@index([requestId])
}

model User {
    id           Uuid              @id @default(uuid())
    email        String            @unique
    name         String
    passwordHash     String
    createdAt        TimestamptzString @default(now())
    sessions         Session[]
    resolvedHandoffs Handoff[]
}

// Copied from the e-commerce port's Session model unchanged.
model Session {
    id             Uuid               @id @default(uuid())
    userId         Uuid
    userAgent      String?
    createdAt      TimestamptzString  @default(now())
    expiresAt      TimestamptzString  @default(sql`(CURRENT_TIMESTAMP + '30 days'::interval)`)
    refreshJti     String
    prevRefreshJti String?
    rotatedAt      TimestamptzString?
    user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
}

model EvalRun {
    id                  Uuid              @id @default(uuid())
    label               String
    subset              String            // "all" or "ci"
    searchMode          String
    splitDepth          Int
    answerPromptVersion String
    chatModel           String
    cases               Int
    passRate            Float
    retrievalHitRate    Float?
    mrr                 Float?
    citationRate        Float?
    factRate            Float?
    notFoundRate        Float?
    intentRate          Float
    refusalRate         Float?
    leadRate            Float?
    firstTokenP50       Int?
    firstTokenP95       Int?
    avgTokensPerCase    Int
    costMicros          Int
    createdAt           TimestamptzString @default(now())
    results             EvalResult[]
}

model EvalResult {
    id               Uuid    @id @default(uuid())
    runId            Uuid
    caseId           String
    category         String
    passed           Boolean
    intent           String?
    intentOk         Boolean
    retrievalHit     Boolean?
    reciprocalRank   Float?
    citationOk       Boolean?
    invalidCitations Int     @default(0)
    factsOk          Boolean?
    notFoundOk       Boolean?
    leadOk           Boolean?
    firstTokenMs     Int?
    totalMs          Int
    tokens           Int
    costMicros       Int
    answer           String
    error            String?
    run              EvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

    @@index([runId])
}


