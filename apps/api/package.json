{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "db:sql": "tsx src/scripts/write-migration-sql.ts",
    "seed:staff": "tsx src/scripts/seed-staff.ts",
    "worker": "tsx watch src/worker.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "search": "tsx src/scripts/search.ts",
    "llm:smoke": "tsx src/scripts/llm-smoke.ts",
    "ask": "tsx src/scripts/ask.ts",
    "leads:renotify": "tsx src/scripts/renotify-leads.ts",
    "report": "tsx src/scripts/report.ts",
    "eval:check": "tsx src/evals/check.ts",
    "eval": "tsx src/evals/run.ts",
    "retention": "tsx src/scripts/retention.ts",
    "e2e:prepare": "node --env-file=.env.test --import tsx src/scripts/e2e-prepare.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.6.1",
    "@bull-board/express": "^8.6.1",
    "@google/genai": "^2.27.0",
    "@prisma/cli-engine": "0.6.2",
    "@prisma/orm-extension-pgvector": "8.0.0-rc.14",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "@repo/content": "workspace:^",
    "@repo/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.8",
    "resend": "^4.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "8.20.4",
    "@types/proxy-addr": "^2.0.3",
    "eslint": "^9.39.5",
    "prisma": "8.0.0-rc.20",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
